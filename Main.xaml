<Activity mc:Ignorable="sap sap2010" x:Class="Main" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_InventoryFile" Type="InArgument(x:String)" />
    <x:Property Name="out_PurchaseRequestFile" Type="OutArgument(x:String)" />
  </x:Members>
  <VisualBasic.Settings>
    <x:Null />
  </VisualBasic.Settings>
  <sap2010:WorkflowViewState.IdRef>ActivityBuilder_1</sap2010:WorkflowViewState.IdRef>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>GlobalConstantsNamespace</x:String>
      <x:String>GlobalVariablesNamespace</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Collections.ObjectModel</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>UiPath.Excel.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
      <AssemblyReference>System.ObjectModel</AssemblyReference>
      <AssemblyReference>System.ComponentModel.TypeConverter</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Automated Inventory Reordering" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="[If(String.IsNullOrWhiteSpace(in_InventoryFile), System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;Inventory.xlsx&quot;), in_InventoryFile)]" Name="inventoryFile" />
      <Variable x:TypeArguments="x:String" Default="[System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;PurchaseRequests.xlsx&quot;)]" Name="purchaseRequestFile" />
      <Variable x:TypeArguments="sd:DataTable" Name="inventoryData" />
      <Variable x:TypeArguments="sd:DataTable" Name="purchaseRequests" />
      <Variable x:TypeArguments="x:Int32" Name="reorderCount" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:LogMessage DisplayName="Start inventory review" sap2010:WorkflowViewState.IdRef="LogMessage_1" Message="[&quot;Inventory reorder review started. Source: &quot; &amp; inventoryFile]" />
    <ui:ReadRange AddHeaders="True" DataTable="[inventoryData]" DisplayName="Read inventory sheet" sap2010:WorkflowViewState.IdRef="ReadRange_1" Range="[&quot;A1&quot;]" SheetName="[&quot;Inventory&quot;]" WorkbookPath="[inventoryFile]" />
    <ui:InvokeCode Code="Dim result As New System.Data.DataTable()&#xA;result.Columns.Add(&quot;SKU&quot;, GetType(String))&#xA;result.Columns.Add(&quot;ItemName&quot;, GetType(String))&#xA;result.Columns.Add(&quot;Supplier&quot;, GetType(String))&#xA;result.Columns.Add(&quot;CurrentStock&quot;, GetType(Integer))&#xA;result.Columns.Add(&quot;ReorderPoint&quot;, GetType(Integer))&#xA;result.Columns.Add(&quot;TargetStock&quot;, GetType(Integer))&#xA;result.Columns.Add(&quot;ReorderQuantity&quot;, GetType(Integer))&#xA;result.Columns.Add(&quot;RequestDate&quot;, GetType(System.DateTime))&#xA;result.Columns.Add(&quot;Status&quot;, GetType(String))&#xA;&#xA;For Each sourceRow As System.Data.DataRow In inputData.Rows&#xA;    Dim currentStock As Integer = System.Convert.ToInt32(sourceRow(&quot;CurrentStock&quot;))&#xA;    Dim reorderPoint As Integer = System.Convert.ToInt32(sourceRow(&quot;ReorderPoint&quot;))&#xA;    Dim targetStock As Integer = System.Convert.ToInt32(sourceRow(&quot;TargetStock&quot;))&#xA;    If currentStock &lt;= reorderPoint Then&#xA;        Dim quantity As Integer = System.Math.Max(0, targetStock - currentStock)&#xA;        result.Rows.Add(sourceRow(&quot;SKU&quot;).ToString(), sourceRow(&quot;ItemName&quot;).ToString(), sourceRow(&quot;Supplier&quot;).ToString(), currentStock, reorderPoint, targetStock, quantity, System.DateTime.Today, &quot;Purchase Request&quot;)&#xA;    End If&#xA;Next&#xA;outputData = result&#xA;reorderTotal = result.Rows.Count" ContinueOnError="False" DisplayName="Calculate reorder requirements" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="inputData">[inventoryData]</InArgument>
        <OutArgument x:TypeArguments="sd:DataTable" x:Key="outputData">[purchaseRequests]</OutArgument>
        <OutArgument x:TypeArguments="x:Int32" x:Key="reorderTotal">[reorderCount]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:WriteRange DataTable="[purchaseRequests]" DisplayName="Write purchase requests" sap2010:WorkflowViewState.IdRef="WriteRange_1" SheetName="[&quot;PurchaseRequests&quot;]" StartingCell="[&quot;A1&quot;]" WorkbookPath="[purchaseRequestFile]" />
    <Assign DisplayName="Return output path" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_PurchaseRequestFile]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[purchaseRequestFile]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:LogMessage DisplayName="Report reorder count" sap2010:WorkflowViewState.IdRef="LogMessage_2" Message="[&quot;Inventory review completed. Purchase requests generated: &quot; &amp; reorderCount.ToString()]" />
  </Sequence>
</Activity>